.pnpm-store/
dist/
.astro/
coverage/
coverage.out
coverage.html
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Match data: never committed; it lives outside the repo --------------------
# Anchored: engine/src/data/ is code, and must stay tracked.
/data/
/engine/data/

