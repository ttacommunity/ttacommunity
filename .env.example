# Local development only. scripts/dev.sh copies this to .env if there is none.
# The same names configure native runs and the cluster.

API_ADDR=:8080

RATINGS_DB_PASSWORD=local-only-ratings
RATINGS_READ_DB_PASSWORD=local-only-ratings-read
APP_DB_PASSWORD=local-only-app
RATINGS_DATABASE_URL=postgres://ratings:local-only-ratings@127.0.0.1:55432/ratings?sslmode=disable
# The api's read-only login. scripts/dev.sh creates it.
RATINGS_READ_DATABASE_URL=postgres://ratings_api:local-only-ratings-read@127.0.0.1:55432/ratings?sslmode=disable
APP_DATABASE_URL=postgres://app:local-only-app@127.0.0.1:55433/app?sslmode=disable
