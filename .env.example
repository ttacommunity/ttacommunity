# Local development only. scripts/dev.sh copies this to .env if there is none.
# The same names configure native runs and the cluster.

API_ADDR=127.0.0.1:8080
# Prometheus metrics at /metrics, on a listener of their own. Unset: not served.
METRICS_ADDR=127.0.0.1:8081

RATINGS_DB_PASSWORD=local-only-ratings
RATINGS_READ_DB_PASSWORD=local-only-ratings-read
APP_DB_PASSWORD=local-only-app
RATINGS_DATABASE_URL=postgres://ratings:local-only-ratings@127.0.0.1:55432/ratings?sslmode=disable
# The api's read-only login. scripts/dev.sh creates it.
RATINGS_READ_DATABASE_URL=postgres://ratings_api:local-only-ratings-read@127.0.0.1:55432/ratings?sslmode=disable
APP_DATABASE_URL=postgres://app:local-only-app@127.0.0.1:55433/app?sslmode=disable

# Admin: the api's admin login (scripts/dev.sh creates it) and the Access app
# its tokens come from. ADMIN_DEV_USER (local only) signs requests without an
# Access token in as that admin; the api refuses it unless ADMIN_ORIGIN and
# API_ADDR are 127.0.0.1 and it runs outside Kubernetes. Add the admin first:
# go run ./cmd/load -add-admin 100000000000000001 -name "Local admin" -role admin
RATINGS_ADMIN_DB_PASSWORD=local-only-ratings-admin
RATINGS_ADMIN_DATABASE_URL=postgres://ratings_admin_api:local-only-ratings-admin@127.0.0.1:55432/ratings?sslmode=disable
ACCESS_TEAM=https://ttacommunitydev.cloudflareaccess.com
ACCESS_AUD=local-only-no-access-app
# The admin site, the only origin admin changes are accepted from.
ADMIN_ORIGIN=http://127.0.0.1:4322
ADMIN_DEV_USER=100000000000000001

# Player sign-in on the site: the api's player login (scripts/dev.sh creates it),
# the site sign-in returns to, and this api's own origin, for Discord's callback.
# DISCORD_DEV_USER (local only) stands in for Discord, signing everyone in as
# that invented account; the api refuses it unless API_ADDR and SITE_ORIGIN are
# 127.0.0.1, it runs outside Kubernetes and no DISCORD_CLIENT_ID is set. To try
# a real Discord app, empty it and set the app's id and secret; the app's
# redirects must include API_ORIGIN/v1/auth/discord/callback.
RATINGS_PLAYER_DB_PASSWORD=local-only-ratings-player
RATINGS_PLAYER_DATABASE_URL=postgres://ratings_player_api:local-only-ratings-player@127.0.0.1:55432/ratings?sslmode=disable
SITE_ORIGIN=http://127.0.0.1:4321
API_ORIGIN=http://127.0.0.1:8080
DISCORD_DEV_USER=local_player
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Microsoft sign-in, off when all of these are empty. MICROSOFT_DEV_USER (local
# only, on DISCORD_DEV_USER's terms, and with no MICROSOFT_CLIENT_ID) stands in
# for Microsoft as an account of that name, with MICROSOFT_DEV_EMAIL as its
# verified email when set. A real app's Web redirects must include
# API_ORIGIN/v1/auth/microsoft/callback.
MICROSOFT_DEV_USER=Local_Player
MICROSOFT_DEV_EMAIL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Google sign-in, off when all of these are empty. GOOGLE_DEV_USER (local only,
# on DISCORD_DEV_USER's terms, and with no GOOGLE_CLIENT_ID) stands in for
# Google as an account of that name, with GOOGLE_DEV_EMAIL as its verified email
# when set. A real app's Web client must list API_ORIGIN/v1/auth/google/callback
# among its authorised redirect URIs.
GOOGLE_DEV_USER=Local_Player
GOOGLE_DEV_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email sign-in. EMAIL_DEV_MAIL (local only, on DISCORD_DEV_USER's terms, and with
# no RESEND_API_KEY) prints each link on the api's console instead of sending it.
# The Turnstile keys are Cloudflare's published test keys, which pass every
# check; the api refuses them unless EMAIL_DEV_MAIL is set. Production sets
# RESEND_API_KEY, EMAIL_FROM and a real TURNSTILE_SECRET instead.
EMAIL_DEV_MAIL=1
EMAIL_SUPPORT=support@ttacommunity.org
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
RESEND_API_KEY=
EMAIL_FROM=
