---
/** Every token and component of the design system on sample data, to check the look by eye. */
import SiteLayout from '../layouts/SiteLayout.astro';
import '../components/Blitz.css';
import Segmented from '@ttac/shared/Segmented';
import ToggleGroup from '@ttac/shared/ToggleGroup';
import MetricCard, { MetricGrid } from '../components/MetricCard';
import MeanBadge, { MeanBadges } from '../components/MeanBadge';
import ViewBar, { FormatPick } from '../components/ViewBar';
import DialogSamples from '../components/DialogSamples';
import OptionsSample from '../components/OptionsSample';
import Note from '@ttac/shared/Note';
import OutcomeNotice from '@ttac/shared/OutcomeNotice';
import Inset from '@ttac/shared/Inset';
import Tex from '../components/Tex';
import { divisionTagClass } from '../lib/divisions';
import SignInNote from '../components/SignInNote';
import SignUpSamples from '../components/SignUpSamples';
import PlayerSearchSamples from '../components/PlayerSearchSamples';
import ScrollTable from '../components/ScrollTable';
import ShowAllSample from '../components/ShowAllSample';
import TileSamples, { FigureSamples, HighlightSamples } from '../components/TileSamples';
import Message from '../components/Message';
import { Flag, TitleBadge, VideosButton, VideosLink } from '../components/PlayerMarks';
import PlayerLink from '../components/PlayerLink';
import { titleCodeValues } from '@ttac/shared/api';
import type { TitleCode } from '@ttac/shared/ratings';
import PageHeader from '@ttac/shared/PageHeader';
import SubpageNav from '../components/SubpageNav.astro';
import Panel from '../components/Panel';
import Panels from '../components/Panels';
import HomeHeader from '../components/HomeHeader.astro';
import PanelHeader from '../components/PanelHeader';
import SeasonPick from '../components/SeasonPick';
import TitleSelect from '../components/TitleSelect';
import MinOppsField from '../components/MinOppsField';
import NewerOlder from '@ttac/shared/NewerOlder';
import CopyCode from '@ttac/shared/CopyCode';
import AssetsTable from '../components/AssetsTable';
import GameSeatFields from '@ttac/shared/GameSeatFields';
import { emptyGameForm } from '@ttac/shared/game-form';

// The roles pages colour with (the palette is used only in tokens.css).
const colours = [
  'bg-dark',
  'surface-panel',
  'surface-well',
  'surface-code',
  'text-main',
  'text-soft',
  'text-muted',
  'text-accent',
  'text-accent-bright',
  'player-name',
  'border-subtle',
  'win',
  'win-light',
  'win-edge',
  'loss',
  'loss-light',
  'loss-edge',
  'draw',
  'medal-gold',
  'medal-silver',
  'medal-bronze',
  'special',
  'model-daneo',
  'model-daneo-reset',
  'model-std',
];
const fonts = [
  ['heading', 'Cinzel'],
  ['subheading', 'Marcellus'],
  ['body', 'Source Serif 4'],
  ['stats', 'Inter'],
];
const formats = [
  { value: 0, label: 'All Formats' },
  { value: 2, label: '2-Player (Duel)' },
  { value: 3, label: '3-Player' },
  { value: 4, label: '4-Player' },
];
const rows = [
  { rank: 1, country: 'DE', title: 'WC', name: 'Sample Player One', c: '1934.12', r: '2071.4', rd: '±45.8', opps: 212, w: 140, l: 60, d: 12, pct: '68.9%', last: '2026-09-01' },
  { rank: 2, country: null, title: 'GM', name: 'Sample Player Two', c: '1901.77', r: '2050.0', rd: '±49.4', opps: 180, w: 110, l: 64, d: 6, pct: '62.8%', last: '2026-08-28' },
  { rank: 4, country: 'CA', title: null, name: 'Sample Player Four', c: '1790.30', r: '1955.2', rd: '±55.0', opps: 95, w: 51, l: 42, d: 2, pct: '54.7%', last: '-' },
] as const;
---
<SiteLayout title="Design system | ttacommunity" description="The ratings site's colours, fonts and components.">
  <meta slot="head" name="robots" content="noindex" />

  <PageHeader title="Design system" subtitle="Upstream's look, taken from its CSS. Sample data only." />

  <div class="design">

    <h2>Colours</h2>
    <ul class="swatches">
      {colours.map((c) => (
        <li>
          <span class:list={['swatch', `swatch-${c}`]}></span>
          <code>--{c}</code>
        </li>
      ))}
    </ul>

    <h2>Fonts</h2>
    <ul class="fonts">
      {fonts.map(([token, name]) => (
        <li class={`font-${token}`}>
          <code>--font-{token}</code> {name}: Through the Ages, 1234.56
        </li>
      ))}
    </ul>

    <h2>Format bar</h2>
    <div class="format-bar">
      <Segmented label="Format" options={formats} value={0} onChange={() => {}} />
      <label>
        <span class="visually-hidden">Rating engine</span>
        <select class="input-antique">
          <option>GlickoD</option>
          <option>Glicko-2 Standard · Season Reset</option>
        </select>
      </label>
      <div class="format-bar-actions">
        <PlayerSearchSamples client:only="react" />
        <button type="button" class="btn-antique">Options</button>
      </div>
    </div>

    <h2>Player search</h2>
    <p>Every player search and filter is this one box, <code>PlayerSearch</code>: its options say what it does (search, fill a field, filter), never how it looks or what it says.</p>
    <PlayerSearchSamples client:only="react" />

    <h2>Button rows</h2>
    <p>A choice sets what a page shows (above); tabs choose a part of a page; a filter picks one of many. All wrap on a phone.</p>
    <Segmented label="Sample tabs" look="tabs" options={[{ value: 'seasons', label: 'Seasons' }, { value: 'highlights', label: 'Highlights' }]} value="seasons" onChange={() => {}} />
    <Segmented label="Sample filter" look="filter" options={[{ value: 'all', label: 'All' }, { value: 'majors', label: 'Majors' }, { value: 'ladders', label: 'Ladders' }]} value="all" onChange={() => {}} />

    <h2>Toggle group</h2>
    <ToggleGroup label="Sample toggles" all="All" options={[{ value: 'one', label: 'One' }, { value: 'two', label: 'Two' }]} chosen={new Set(['one'])} onChange={() => {}} />

    <h2>View bar</h2>
    <ViewBar>
      <FormatPick value={0} onChange={() => {}} what="the sample" />
    </ViewBar>

    <h2>Headline figures</h2>
    <MetricGrid>
      <MetricCard label="Sample count" value="1,234" note="A note under it" tone="win" />
      <MetricCard label="Sample share" value="56.7%" note="Muted" tone="muted" />
      <MetricCard label="Sample total" value="890" tone="gold" />
      <MetricCard label="Sample players" value="42" note="Sky" tone="sky" />
    </MetricGrid>
    <FigureSamples />

    <h2>Headline figures: compact, a page header's facts</h2>
    <MetricGrid compact>
      <MetricCard label="Active history" value="2021 – 2026" tone="gold" />
      <MetricCard label="Seasons" value="7" tone="gold" />
      <MetricCard label="Schedule" value="Annual (Every Year)" tone="gold" words />
    </MetricGrid>

    <h2>Tiles</h2>
    <TileSamples />

    <h2>Highlights</h2>
    <HighlightSamples />

    <h2>Mean ratings</h2>
    <MeanBadges>
      <MeanBadge engine="glicko2_daneo" mean={1450.25} active={1540} />
      <MeanBadge engine="glicko2_std" mean={1460} />
    </MeanBadges>

    <h2>Badges</h2>
    <p class="design-row">
      <span class="badge badge-format">All Formats</span>
      <span class="badge badge-mode">Continuous (Career)</span>
    </p>
    <p class="design-row">
      {titleCodeValues.map((code: TitleCode) => <TitleBadge title={{ code, reason: `Sample ${code} reason` }} />)}
      <TitleBadge title={null} />
    </p>
    <p class="design-row">
      {titleCodeValues.map((code: TitleCode) => <TitleBadge title={{ code }} long />)}
    </p>

    <h2>Flags</h2>
    <p class="design-row">
      <Flag country="PL" />
      <Flag country="US" />
      <Flag country="ES" />
      <Flag country={null} />
    </p>

    <h2>Videos link</h2>
    <p class="design-row">
      Invented Caster <VideosLink name="Invented Caster" hasVideos />
    </p>
    <p class="design-row design-buttons">
      <VideosButton name="Invented Caster" hasVideos />
    </p>

    <h2>Text to copy</h2>
    <p>A replay code, or an image's address: the button copies it, and ticks.</p>
    <CopyCode client:only="react" code="ABC123XY" />
    <CopyCode client:only="react" code="https://assets.ttacommunity.org/sample-0123456789ab.png" what="address" />

    <h2>Images</h2>
    <p>Stored images, each small with its address to copy; admin adds a column of actions.</p>
    <AssetsTable
      client:only="react"
      zone="UTC"
      caption="Sample images"
      images={[{ key: 'sample-0123456789ab.png', url: '/favicon.png', size: 12500, uploaded: '2026-11-21T10:30:00Z' }]}
    />

    <h2>Buttons</h2>
    <p class="design-row design-buttons">
      <button type="button" class="btn-antique">An action</button>
      <button type="button" class="btn-antique btn-danger">One that cannot be undone</button>
      <button type="button" class="btn-quiet">A quiet one: cancel, reset, close</button>
      <button type="button" class="btn-icon" aria-label="An icon">✕</button>
      <button type="button" class="btn-close" aria-label="Close an overlay">×</button>
      <button type="button" class="btn-antique" disabled>Not now</button>
    </p>
    <p class="design-row design-buttons">
      <input class="input-antique" type="text" aria-label="A field beside buttons" placeholder="A field, at the same height" />
      <button type="button" class="btn-antique">Search</button>
      <button type="button" class="btn-quiet">Clear</button>
    </p>
    <p class="design-row design-buttons">
      <span>In a table row or list:</span>
      <button type="button" class="btn-antique btn-compact">Compare</button>
      <button type="button" class="btn-quiet btn-compact">Reveal</button>
      <button type="button" class="btn-icon btn-compact" aria-label="Copy">📋</button>
    </p>

    <h2>Labels</h2>
    <p class="design-row design-buttons">
      <span class="tag">A tag</span>
      <span class="tag tag-special">Something special</span>
      {['Grandmaster', 'Master', 'Diamond', 'Platinum', 'Gold', 'Silver', 'Bronze', 'Wood'].map((d) => <span class={divisionTagClass(d, 'international')}>{d}</span>)}
    </p>
    <p class="design-row design-buttons">
      {['Emperor', 'King', 'Prince', 'Duke', 'Marquess', 'Count', 'Viscount', 'Baron'].map((d) => <span class={divisionTagClass(d, 'royal_league')}>{d}</span>)}
    </p>
    <p class="design-row design-buttons">
      <span class="pill">Active Players: <strong>3,695</strong></span>
      <span class="pill pill-win">77.5%</span>
      <span class="pill pill-loss">-15.7% vs Format</span>
      <span class="pill pill-gold">1: 9</span>
      <span class="pill pill-silver">2: 4</span>
      <span class="pill pill-bronze">3: 2</span>
    </p>
    <p class="design-row design-buttons">
      <span class="chip">Search: "invented" <a class="chip-remove" href="/design/" aria-label="Clear search terms">✕</a></span>
      <span class="chip chip-out">Excluded: "sample" <a class="chip-remove" href="/design/" aria-label="Remove exclusion">✕</a></span>
      <button type="button" class="btn-quiet btn-compact">Clear Filters</button>
    </p>
    <p class="design-row design-buttons">
      <span class="status">Retired</span>
      <span class="status status-gold">Active</span>
      <span class="status status-good">First entry</span>
      <span class="status status-warn">Counts as 0</span>
      <span class="status status-bad">bug</span>
    </p>

    <h2>A player's game result</h2>
    <div class="report-row">
      <GameSeatFields form={{ ...emptyGameForm('2026-09-01', 'Unknown'), b_outcome: 'resigned' }} who="b" name="Sample Player Two" onChange={() => {}} />
    </div>

    <h2>Dialog</h2>
    <DialogSamples client:only="react" />

    <h2>Options drawer</h2>
    <OptionsSample client:only="react" />

    <h2>Page header</h2>
    <PageHeader icon="📜" title="Sample page" subtitle="What the page holds, in a sentence or two." back={{ href: '/design/', label: 'Back to a list' }} />

    <h2>Page header with a tag</h2>
    <PageHeader tag="Annual sample" emblem="🏆" title="Sample tournament" subtitle="A tournament's header carries its tagline at the top right, and its icon as an emblem beside the title." />

    <h2>Home header</h2>
    <p>The home page's own header, the one page header that is not the page header below; the live figures go in its slot.</p>
    <HomeHeader />

    <h2>Page header: centred</h2>
    <PageHeader centred title="Sample player" subtitle="A player's pages: centred, the name in the heading face." back={{ href: '/design/', label: 'Back to a list' }} />

    <h2>Panel</h2>
    <Panel id="design-panel" icon="🏅" title="Sample panel" subtitle="What the panel shows, in a sentence.">
      <p>A page's panel: the card, full width, with its header. Its content goes here.</p>
    </Panel>

    <h2>Panels</h2>
    <Panels>
      <Panel id="design-panels-1" title="First panel">
        <p>A page's panels go in Panels, one under another; its gap is the only space between them.</p>
      </Panel>
      <Panel id="design-panels-2" title="Second panel">
        <p>A row of panels side by side sits in it as one item.</p>
      </Panel>
    </Panels>

    <h2>Panel stripe: commentary</h2>
    <Panels>
      <Panel id="design-stripe-gold" icon="📜" title="A summary or guide" stripe="gold">
        <p>A stripe marks a panel of commentary about the data: what a table means, a player's career in words. Data panels (tables, charts, lists) have none.</p>
      </Panel>
      <Panel id="design-stripe-green" title="A finding" stripe="green">
        <p>Green for a finding the data shows.</p>
      </Panel>
      <Panel id="design-stripe-bronze" title="A deep dive" stripe="bronze">
        <p>Bronze for a deep dive, as the FAQ's.</p>
      </Panel>
    </Panels>

    <h2>Panel size: reading</h2>
    <Panel id="design-reading" title="A form or prose" size="reading">
      <p>A panel read top to bottom, such as a sign-in form or the terms, sits centred at about 70 characters a line. Tables, charts and lists take the full width, the default; a table with more columns than the page is wide takes the screen's width (size screen).</p>
    </Panel>

    <h2>Panel of text to read</h2>
    <Panel id="design-text" title="A document" size="reading" holds="text">
      <p>Text to read, such as the FAQ, the methodology or the terms, in the reading look: its paragraphs, lists and headings.</p>
      <h3>A heading inside it</h3>
      <ul>
        <li>A list item.</li>
        <li>Another, with <code>code</code> in it.</li>
      </ul>
    </Panel>

    <h2>Panel picture</h2>
    <Panel id="design-art" title="A panel with a picture" art="/img/groups/classic.jpg">
      <p>A picture shown faintly behind the panel, such as a challenge group's art.</p>
    </Panel>

    <h2>Panel header</h2>
    <PanelHeader icon="🏅" title="Sample panel">
      <span class="tag">12 rows</span>
    </PanelHeader>
    <PanelHeader title="Sample panel with seasons">
      <SeasonPick id="design-season" seasons={[{ label: '2025' }, { label: '2026' }]} value="2026" word="Season" onChange={() => {}} />
    </PanelHeader>
    <PanelHeader title="Sample panel with a line under it" subtitle="What the panel shows, in a sentence." />

    <h2>Sub-page tabs</h2>
    <SubpageNav label="Sample pages" tabs={[{ label: 'This page', href: '/design/', current: true }, { label: 'Another page', href: '/design/' }, { label: 'Not built yet' }]}>
      <a href="/design/" class="btn-antique">An action</a>
    </SubpageNav>

    <h2>Notes</h2>
    <Note>A note in front of the reader, such as what to do before taking part.</Note>
    <Note title="A note with a title">
      <p>The title sits on its own line; the text can run to several paragraphs.</p>
      <p>A second paragraph.</p>
    </Note>
    <Note title="Banned" tone="warning">
      <p>A warning: something that stops the reader, such as a ban.</p>
    </Note>
    <SignInNote client:only="react" lead="Playing in this tournament?" to="report your game’s result." />

    <h2>Action outcomes</h2>
    <OutcomeNotice kind="done" text="What an action did, beside it." scroll={false} />
    <OutcomeNotice kind="refused" text="Why the action was refused." scroll={false} />

    <h2>Boxes inside a panel</h2>
    <div class="design-stack">
      <Inset>A group of content, such as a worked example.</Inset>
      <Inset form="figures">
        <span>Games <strong>118</strong></span>
        <span>Average culture <strong>234.9</strong></span>
        <span>Best seat <strong>4P Seat 2</strong></span>
      </Inset>
      <Inset form="line">A short line, such as an empty list.</Inset>
      <Inset form="row">
        <span>An item of a list</span>
        <strong>1,234</strong>
      </Inset>
    </div>

    <h2>A player's name</h2>
    <p class="design-row">
      <PlayerLink name="Invented Player" />
      <PlayerLink name="First Place" place={1} />
      <PlayerLink name="Second Place" place={2} />
      <PlayerLink name="Third Place" place={3} />
      <PlayerLink name="Last Place" place="last" />
      <PlayerLink name="Not The Subject" quiet />
    </p>

    <h2>Prose</h2>
    <blockquote>“A quotation in the site’s prose: Markdown’s quote in MDX.”</blockquote>
    <div class="formula"><Tex client:only="react" tex={String.raw`C = \mathrm{Rating} - 3 \times \mathrm{RD}`} /></div>

    <h2>Sign-up box</h2>
    <SignUpSamples client:only="react" />

    <h2>Messages</h2>
    <Message>A message where a page's content would be, such as nothing found.</Message>
    <Message form="inline">The same, as a line in a panel.</Message>

    <h2>Filters</h2>
    <p class="design-row">
      <TitleSelect id="design-title" titles={['GM', 'M', 'P']} value={null} onChange={() => {}} />
    </p>
    <p class="design-row">
      <MinOppsField id="design-min-opps" value={30} onApply={() => {}} />
    </p>

    <h2>Tooltip</h2>
    <p class="design-row">
      <span data-tooltip="Upstream's hover tooltip, in a gold-edged box.">Hover over this text</span>
    </p>

    <h2>Table</h2>
    <p>Every table sits in <code>ScrollTable</code>: wider than its box, it scrolls sideways, shades the side with more, and on a phone says so. Numbers sit at the end (<code>num</code>).</p>
    <ScrollTable client:visible label="Sample leaderboard">
      <table class="leaderboard-table">
        <caption class="visually-hidden">Sample leaderboard</caption>
        <thead>
          <tr>
            <th scope="col"><span data-tooltip="Current competitive ranking.">Rank</span></th>
            <th scope="col">Flag</th>
            <th scope="col">Player</th>
            <th scope="col">Title</th>
            <th scope="col">C-Rating</th>
            <th scope="col">Rating ± RD</th>
            <th scope="col">Opps</th>
            <th scope="col">W-L-D</th>
            <th scope="col">Win %</th>
            <th scope="col"><span data-tooltip="Date of the most recent match.">Last Played</span></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((p) => (
            <tr>
              <td class:list={['rank-col', { 'top-3-rank': p.rank <= 3 }]}>#{p.rank}</td>
              <td><Flag country={p.country} /></td>
              <th scope="row"><span class="player-name">{p.name}</span></th>
              <td><TitleBadge title={p.title === null ? null : { code: p.title, reason: 'Sample reason' }} /></td>
              <td><span class="c-rating-val">{p.c}</span></td>
              <td><span class="rating-primary">{p.r}</span> <span class="rating-rd">{p.rd}</span></td>
              <td>{p.opps}</td>
              <td>
                <span class="wld-win">{p.w}</span> - <span class="wld-loss">{p.l}</span> - <span class="wld-draw">{p.d}</span>
              </td>
              <td><strong>{p.pct}</strong></td>
              <td class="last-played">{p.last}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </ScrollTable>

    <h2>Long table</h2>
    <p>A long table shows its first 10 rows and a Show all button (<code>ShowAll</code>, <code>shownRows</code>).</p>
    <ShowAllSample client:only="react" />

    <NewerOlder page={2} pages={5} onPage={() => {}} />
  </div>
</SiteLayout>

<style>
  .design > h2 {
    margin: 1.75rem 0 0.6rem;
    color: var(--text-accent);
    font-family: var(--font-subheading);
    font-size: 1.1rem;
  }

  .design-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 1.5rem 0 0.5rem;
    font-family: var(--font-stats);
  }

  .design-stack,
  .design :global(.design-stack) {
    display: grid;
    gap: 0.75rem;
  }

  .design :global(.design-tiles) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .design :global(.design-tile-img) {
    width: 100%;
    height: auto;
    aspect-ratio: 340 / 284;
    object-fit: cover;
  }

  .design :global(.metric-grid + .metric-grid) {
    margin-top: 1.25rem;
  }

  .design-row.design-buttons,
  .design :global(.dialog-samples) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.6rem;
    list-style: none;
  }

  .swatches li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }

  .swatch {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--swatch-edge);
    border-radius: 4px;
  }

  .swatch-bg-dark { background: var(--bg-dark); }
  .swatch-surface-panel { background: var(--surface-panel); }
  .swatch-surface-well { background: var(--surface-well); }
  .swatch-surface-code { background: var(--surface-code); }
  .swatch-text-main { background: var(--text-main); }
  .swatch-text-soft { background: var(--text-soft); }
  .swatch-text-muted { background: var(--text-muted); }
  .swatch-text-accent { background: var(--text-accent); }
  .swatch-text-accent-bright { background: var(--text-accent-bright); }
  .swatch-player-name { background: var(--player-name); }
  .swatch-border-subtle { background: var(--border-subtle); }
  .swatch-win { background: var(--win); }
  .swatch-win-light { background: var(--win-light); }
  .swatch-win-edge { background: var(--win-edge); }
  .swatch-loss { background: var(--loss); }
  .swatch-loss-light { background: var(--loss-light); }
  .swatch-loss-edge { background: var(--loss-edge); }
  .swatch-draw { background: var(--draw); }
  .swatch-medal-gold { background: var(--medal-gold); }
  .swatch-medal-silver { background: var(--medal-silver); }
  .swatch-medal-bronze { background: var(--medal-bronze); }
  .swatch-special { background: var(--special); }
  .swatch-model-daneo { background: var(--model-daneo); }
  .swatch-model-daneo-reset { background: var(--model-daneo-reset); }
  .swatch-model-std { background: var(--model-std); }

  .fonts {
    display: grid;
    gap: 0.4rem;
    list-style: none;
    font-size: 1.15rem;
  }

