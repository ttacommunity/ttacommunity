---
import { getEntry, render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import '../../../components/MethodologyPage.css';
import PageHeader from '@ttac/shared/PageHeader';
import Panel from '../../../components/Panel';

const page = await getEntry('pages', 'methodology');
if (page === undefined) throw new Error('src/content/methodology.mdx is missing');
const { Content } = await render(page);
---
<SiteLayout title="Methodology | Through the Ages" description="The mathematics behind the Through the Ages rating engines: Glicko-2, multiplayer weighting, season resets and GlickoD.">
  <div class="methodology">
    <PageHeader
      title={page.data.title}
      subtitle={`The formal derivations behind the rating engines, written by DANeo for the original ratings site. Last edited: ${page.data.updated}.`}
    />

    <Panel label={page.data.title} className="methodology-body">
      <Content />
    </Panel>
  </div>
</SiteLayout>
