---
import { getEntry, render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import '../../../components/MethodologyPage.css';

const page = await getEntry('pages', 'methodology');
if (page === undefined) throw new Error('src/content/methodology.mdx is missing');
const { Content } = await render(page);
---
<SiteLayout title="Methodology | Through the Ages" description="The mathematics behind the Through the Ages rating engines: Glicko-2, multiplayer weighting, WHR, season resets and GlickoD.">
  <div class="methodology">
    <div class="analysis-hero-card">
      <div>
        <h1 class="analysis-hero-title">{page.data.title}</h1>
        <p class="analysis-hero-desc">
          The formal derivations behind the rating engines, written by DANeo for the original ratings site. Last edited: {page.data.updated}.
        </p>
      </div>
    </div>

    <article class="methodology-body">
      <Content />
    </article>
  </div>
</SiteLayout>
