---
import { PUBLIC_API_URL } from 'astro:env/client';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import AnalysisNav from '../../../../components/AnalysisNav.astro';
import MoversPage from '../../../../components/MoversPage';
import '../../../../components/AnalysisPage.css';
---
<SiteLayout title="Multi-Engine Player Comparison | Through the Ages" description="Compare Through the Ages players across every rating engine and reset mode.">
  <AnalysisNav page="movers" />

  <div class="analysis-hero-card hero-snug">
    <div>
      <h1 class="analysis-hero-title">Multi-Engine Player Comparison Tool</h1>
      <p class="analysis-hero-desc">
        Inspect and compare individual player rating trajectories across the rating engines (👑 <strong>GlickoD</strong> in its Continuous and Season Reset configurations, and the Glicko-2 Standard benchmark).
      </p>
    </div>
  </div>

  <MoversPage client:only="react" apiUrl={PUBLIC_API_URL} />
</SiteLayout>
