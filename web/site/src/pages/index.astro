---
import '@ttac/shared/styles/tokens.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ttacommunity</title>
    <meta name="description" content="Ratings, tournaments and blitz games for the Through the Ages community." />
  </head>
  <body>
    <header>
      <a class="admin" href="https://ttac-admin.unstableunicorn.dev/">Admin</a>
    </header>
    <main>
      <h1>ttacommunity</h1>
      <p>Ratings, tournaments and blitz games for the Through the Ages community.</p>
      <nav aria-label="Sections">
        <a class="card" href="/ratings/">
          <h2>Ratings</h2>
          <p>The community leaderboard: every rated player, by model and player count.</p>
        </a>
      </nav>
    </main>
  </body>
</html>

<style>
  header {
    display: flex;
    justify-content: flex-end;
    padding: 0.75rem 1rem 0;
  }
  .admin {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--text-muted);
    border-radius: 0.375rem;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .admin:hover,
  .admin:focus-visible {
    border-color: var(--gold);
    color: var(--gold);
  }
  .admin:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  main {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  h1 {
    color: var(--gold);
    font-family: var(--font-display);
  }
  .card {
    display: block;
    max-width: 22rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--text-muted);
    border-radius: 0.5rem;
    color: var(--text);
    text-decoration: none;
  }
  .card:hover,
  .card:focus-visible {
    border-color: var(--gold);
  }
  .card:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .card h2 {
    margin: 0 0 0.25rem;
    color: var(--gold);
    font-family: var(--font-heading);
  }
  .card p {
    margin: 0;
    color: var(--text-muted);
  }
</style>
