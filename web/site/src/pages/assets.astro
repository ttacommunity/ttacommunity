---
/** The assets bucket's images, listed for anyone with the address to link to; not in the menus, and kept out of search. */
import { PUBLIC_API_URL } from 'astro:env/client';
import SiteLayout from '../layouts/SiteLayout.astro';
import AssetsPage from '../components/AssetsPage';
---
<SiteLayout title="Assets | ttacommunity" description="Images the site and the community link to.">
  <meta slot="head" name="robots" content="noindex" />
  <AssetsPage client:only="react" apiUrl={PUBLIC_API_URL} />
</SiteLayout>
