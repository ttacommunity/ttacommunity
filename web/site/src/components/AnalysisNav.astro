---
/** The analysis pages' subpage nav. */
import SubpageNav from './SubpageNav.astro';

interface Props {
  page: 'overview' | 'activity' | 'seats' | 'percentiles';
}

const { page } = Astro.props;
const tabs = [
  { id: 'overview', href: '/ratings/analysis/', label: '📈 Overview & Calibration' },
  { id: 'seats', href: '/ratings/analysis/seats/', label: '🎲 Turn Order & Seats' },
  { id: 'activity', href: '/ratings/analysis/activity/', label: '🌎 Activity & Demographics' },
  { id: 'percentiles', href: '/ratings/analysis/percentiles/', label: '📊 Rating Percentiles' },
].map((t) => ({ ...t, current: t.id === page }));
---
<SubpageNav label="Model analysis pages" tabs={tabs} />
