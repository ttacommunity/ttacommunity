---
/** The Hall of Fame's series tabs, as upstream's series bar; a series without a page yet shows without a link. */
import SubpageNav from './SubpageNav.astro';
import { BUILT, SERIES_NAV, seriesHref, type SeriesTab } from '../lib/tournament-series';

interface Props {
  current: SeriesTab['slug'];
}

const { current } = Astro.props;
const tabs = SERIES_NAV.map((s) => ({
  label: `${s.icon} ${s.label}`,
  href: BUILT.has(s.slug) ? seriesHref(s.slug) : undefined,
  current: s.slug === current,
}));
---
<SubpageNav label="Hall of Fame series" tabs={tabs} />
