---
/** The page shell every site page uses: the header, a breadcrumb below a section on phones, and upstream's footer around the page's content. */
import '@ttac/shared/styles/theme.css';
import { breadcrumb } from '../lib/nav';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const crumbs = breadcrumb(Astro.url.pathname);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <slot name="head" />
  </head>
  <body>
    <SiteHeader />

    <main>
      {crumbs.length > 0 && (
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c) => (
              <li>{c.href !== undefined ? <a href={c.href}>{c.label}</a> : <span aria-current={c.current ? 'page' : undefined}>{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <p><strong>Through the Ages Rating Engine</strong> -- Powered by GlickoD, DANeo's Glicko-2.</p>
        <p class="footer-small">
          Data from competitive online TTA tournaments<span class="run-facts"></span>. &bull;
          Designed and built by DANeo and UnstableUnicorn
        </p>
        <p class="footer-small"><a href="/privacy/">Privacy</a> &middot; <a href="/terms/">Terms</a> &middot; <a href="mailto:support@ttacommunity.org">Contact</a></p>
      </div>
    </footer>

    <div class="site-tooltip" role="tooltip" aria-hidden="true"></div>

    <script>
      import { PUBLIC_API_URL } from 'astro:env/client';
      import { currentRun, siteVisits } from '@ttac/shared/ratings';
      import { viewerZone } from '@ttac/shared/time';
      import { runFacts } from '../lib/run-facts';
      import { placeTooltip } from '../lib/tooltip-position';

      // Without an answer the footer keeps its plain wording; without a visit count it leaves the visits out.
      const facts = document.querySelector('.run-facts');
      if (facts) {
        const visits = siteVisits(PUBLIC_API_URL).catch(() => null);
        currentRun(PUBLIC_API_URL)
          .then(async (run) => (facts.textContent = runFacts(run, viewerZone(), await visits)))
          .catch(() => undefined);
      }

      // The background starts below the header, whose height changes when it wraps.
      const header = document.querySelector('.site-header');
      if (header instanceof HTMLElement) {
        const setHeight = () => document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
        new ResizeObserver(setHeight).observe(header);
      }

      const tooltip = document.querySelector<HTMLElement>('.site-tooltip');
      let target: HTMLElement | null = null;
      const place = () => {
        if (!tooltip || !target) return;
        const at = placeTooltip(
          target.getBoundingClientRect(),
          { width: tooltip.offsetWidth, height: tooltip.offsetHeight },
          { width: window.innerWidth, height: window.innerHeight },
          target.classList.contains('tooltip-bottom'),
        );
        tooltip.style.left = `${at.left}px`;
        tooltip.style.top = `${at.top}px`;
      };
      const show = (e: Event) => {
        const el = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-tooltip]') : null;
        const text = el?.dataset.tooltip?.trim();
        if (!tooltip || !el || !text) return;
        target = el;
        tooltip.textContent = text;
        tooltip.classList.add('visible');
        place();
      };
      const hide = (e: Event) => {
        const next = e instanceof MouseEvent || e instanceof FocusEvent ? e.relatedTarget : null;
        if (!tooltip || !target || (next instanceof Node && target.contains(next))) return;
        target = null;
        tooltip.classList.remove('visible');
      };
      document.addEventListener('mouseover', show, { passive: true });
      document.addEventListener('focusin', show);
      document.addEventListener('mouseout', hide, { passive: true });
      document.addEventListener('focusout', hide);
      window.addEventListener('scroll', place, { passive: true });
      window.addEventListener('resize', place, { passive: true });
    </script>
  </body>
</html>

<style>
  /* The header's styles are shared with admin: @ttac/shared/styles/components/site-header.css. */
  main {
    flex: 1;
    width: 100%;
    max-width: 1400px;
    margin: 2rem auto;
    padding: 0 1.5rem;
  }

  .site-footer {
    margin-top: auto;
    padding: 2rem 1.5rem;
    background: var(--surface-footer);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-stats);
    font-size: 0.85rem;
    text-align: center;
  }

  .footer-container {
    max-width: 1000px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .footer-small {
    margin-top: 0.5rem;
    color: #887864;
    font-size: 0.8rem;
  }

  .footer-small a {
    color: #887864;
    /* Underlined, as the same colour as the text would not show they are links. */
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-small a:hover {
    color: var(--accent-gold);
  }

  /* Phones only: there the bar is folded into the menu, so nothing else says where the page is. */
  .breadcrumb {
    display: none;
    margin-bottom: 1rem;
    font-family: var(--font-stats);
    font-size: 0.82rem;
  }

  @media (max-width: 820px) {
    .breadcrumb {
      display: block;
    }
  }

  /* A dark backing of its own: the page's background art shows behind it. */
  .breadcrumb ol {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0.3rem 0.75rem;
    list-style: none;
    background: var(--surface-inset);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    color: var(--text-muted);
  }

  .breadcrumb li + li::before {
    margin-right: 0.4rem;
    content: '›' / '';
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .breadcrumb a:hover {
    color: var(--accent-gold);
  }

  .breadcrumb [aria-current] {
    color: var(--text-main);
  }

  @media (max-width: 820px) {
    main {
      margin: 1.25rem auto;
      padding: 0 0.75rem;
    }

    .site-footer {
      padding: 1.5rem 1rem;
      padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    }
  }
</style>
