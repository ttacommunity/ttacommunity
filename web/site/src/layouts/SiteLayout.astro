---
/** The page shell every site page uses: upstream's header, nav and footer around the page's content. */
import '@ttac/shared/styles/theme.css';
import { Font } from 'astro:assets';
import { isCurrent, sections } from '../lib/nav';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <Font cssVariable="--font-cinzel" preload />
    <Font cssVariable="--font-marcellus" />
    <Font cssVariable="--font-source-serif" />
    <Font cssVariable="--font-inter" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="brand">
          <img src="/img/home-button.webp" alt="" width="42" height="42" />
          <div>
            <span class="brand-title">Through the Ages</span>
            <span class="brand-subtitle">Competitive Community Hub</span>
          </div>
        </a>
        <button type="button" class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="main-nav">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
        <div class="nav-backdrop"></div>
        <nav id="main-nav" aria-label="Sections">
          <div class="nav-mobile-header">
            <span class="nav-mobile-title">Navigation</span>
            <button type="button" class="nav-close-btn" aria-label="Close navigation">✕</button>
          </div>
          {sections.map((s) => (
            <a href={s.href} class:list={{ active: isCurrent(path, s.href) }} aria-current={isCurrent(path, s.href) ? 'page' : undefined}>
              {s.label}
            </a>
          ))}
          <a href="https://ttac-admin.unstableunicorn.dev/" class="nav-webmaster">⚙️ Webmaster</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <p><strong>Through the Ages Rating Engine</strong> -- Powered by Glicko-2 and Coulom Whole-History Rating.</p>
        <p class="footer-small">
          Data from competitive online TTA tournaments (2017-2026). &bull;
          <a href="https://ttac-admin.unstableunicorn.dev/">Webmaster</a>
        </p>
      </div>
    </footer>

    <div class="site-tooltip" role="tooltip" aria-hidden="true"></div>

    <script>
      import { placeTooltip } from '../lib/tooltip-position';

      // The background starts below the header, whose height changes when it wraps.
      const header = document.querySelector('.site-header');
      if (header instanceof HTMLElement) {
        const setHeight = () => document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
        new ResizeObserver(setHeight).observe(header);
      }

      const nav = document.getElementById('main-nav');
      const toggle = document.querySelector('.nav-toggle');
      const backdrop = document.querySelector('.nav-backdrop');
      const setNav = (open: boolean) => {
        nav?.classList.toggle('open', open);
        backdrop?.classList.toggle('open', open);
        toggle?.classList.toggle('open', open);
        toggle?.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      };
      toggle?.addEventListener('click', () => setNav(!nav?.classList.contains('open')));
      document.querySelector('.nav-close-btn')?.addEventListener('click', () => setNav(false));
      backdrop?.addEventListener('click', () => setNav(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.classList.contains('open')) setNav(false);
      });

      const tooltip = document.querySelector<HTMLElement>('.site-tooltip');
      let target: HTMLElement | null = null;
      const place = () => {
        if (!tooltip || !target) return;
        const at = placeTooltip(
          target.getBoundingClientRect(),
          { width: tooltip.offsetWidth, height: tooltip.offsetHeight },
          { width: window.innerWidth, height: window.innerHeight },
          target.classList.contains('tooltip-bottom'),
        );
        tooltip.style.left = `${at.left}px`;
        tooltip.style.top = `${at.top}px`;
      };
      const show = (e: Event) => {
        const el = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-tooltip]') : null;
        const text = el?.dataset.tooltip?.trim();
        if (!tooltip || !el || !text) return;
        target = el;
        tooltip.textContent = text;
        tooltip.classList.add('visible');
        place();
      };
      const hide = (e: Event) => {
        const next = e instanceof MouseEvent || e instanceof FocusEvent ? e.relatedTarget : null;
        if (!tooltip || !target || (next instanceof Node && target.contains(next))) return;
        target = null;
        tooltip.classList.remove('visible');
      };
      document.addEventListener('mouseover', show, { passive: true });
      document.addEventListener('focusin', show);
      document.addEventListener('mouseout', hide, { passive: true });
      document.addEventListener('focusout', hide);
      window.addEventListener('scroll', place, { passive: true });
      window.addEventListener('resize', place, { passive: true });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.75rem 2rem;
    background: var(--surface-header);
    border-bottom: 2px solid var(--border-subtle);
    backdrop-filter: blur(8px);
  }

  .header-container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--accent-gold);
  }

  .brand:hover {
    color: var(--accent-gold);
  }

  .brand img {
    width: 42px;
    height: 42px;
    object-fit: contain;
  }

  .brand-title {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
  }

  .brand-subtitle {
    display: block;
    color: var(--text-muted);
    font-family: var(--font-subheading);
    font-size: 0.75rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  nav a {
    padding: 0.25rem 0.5rem;
    border-bottom: 2px solid transparent;
    color: var(--text-main);
    font-family: var(--font-subheading);
    font-size: 1.05rem;
    letter-spacing: 0.5px;
    transition: color 0.2s, border-bottom 0.2s;
  }

  nav a:hover,
  nav a.active {
    border-bottom: 2px solid var(--accent-gold);
    color: var(--accent-gold);
  }

  .nav-toggle {
    display: none;
    z-index: 102;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0.5rem;
    background: rgba(43, 29, 20, 0.85);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nav-toggle:hover {
    border-color: var(--accent-gold);
    background: rgba(229, 169, 60, 0.15);
  }

  .hamburger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--accent-gold);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .nav-toggle.open .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle.open .hamburger-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle.open .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 998;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }

  .nav-backdrop.open {
    display: block;
  }

  .nav-mobile-header,
  .nav-webmaster {
    display: none;
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 1400px;
    margin: 2rem auto;
    padding: 0 1.5rem;
  }

  .site-footer {
    margin-top: auto;
    padding: 2rem 1.5rem;
    background: var(--surface-footer);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-stats);
    font-size: 0.85rem;
    text-align: center;
  }

  .footer-container {
    max-width: 1000px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .footer-small {
    margin-top: 0.5rem;
    color: #887864;
    font-size: 0.8rem;
  }

  .footer-small a {
    color: #887864;
  }

  .footer-small a:hover {
    color: var(--accent-gold);
  }

  @media (max-width: 820px) {
    .site-header {
      padding: 0.5rem 1rem;
      padding-top: max(0.5rem, env(safe-area-inset-top));
    }

    .brand img {
      width: 36px;
      height: 36px;
    }

    .brand-title {
      font-size: 1.12rem;
    }

    .brand-subtitle {
      font-size: 0.68rem;
    }

    .nav-toggle {
      display: flex;
    }

    nav {
      position: fixed;
      top: 0;
      right: -320px;
      z-index: 999;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 280px;
      max-width: 85vw;
      height: 100dvh;
      padding: 1.25rem 1rem;
      overflow-y: auto;
      background: rgba(22, 14, 10, 0.98);
      border-left: 2px solid var(--accent-gold);
      box-shadow: -8px 0 30px rgba(0, 0, 0, 0.9);
      backdrop-filter: blur(12px);
      transition: right 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    nav.open {
      right: 0;
    }

    .nav-mobile-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.85rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .nav-mobile-title {
      color: var(--accent-gold);
      font-family: var(--font-heading);
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
    }

    .nav-close-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      padding: 0.25rem 0.5rem;
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.3rem;
      line-height: 1;
      cursor: pointer;
      transition: color 0.2s;
    }

    .nav-close-btn:hover {
      color: var(--loss);
    }

    nav a {
      display: flex;
      align-items: center;
      min-height: 44px;
      margin-bottom: 0.3rem;
      padding: 0.8rem 1rem;
      border-bottom: none;
      border-left: 3px solid transparent;
      border-radius: 5px;
      font-size: 1rem;
    }

    nav a:hover {
      border-bottom: none;
      border-left-color: var(--accent-gold);
      background: rgba(229, 169, 60, 0.12);
      color: var(--accent-gold);
    }

    nav a.active {
      border-bottom: none;
      border-left-color: var(--accent-gold);
      background: rgba(229, 169, 60, 0.22);
      color: var(--accent-gold);
      font-weight: 700;
    }

    nav .nav-webmaster {
      display: flex;
      margin-top: 0.5rem;
      padding-top: 0.85rem;
      border-top: 1px dashed var(--border-subtle);
      color: var(--text-muted);
    }

    main {
      margin: 1.25rem auto;
      padding: 0 0.75rem;
    }

    .site-footer {
      padding: 1.5rem 1rem;
      padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    }
  }
</style>
