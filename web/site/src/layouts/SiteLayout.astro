---
/** The page shell every site page uses: upstream's header and footer around the page's content, with the nav of the page's area (the ratings, or the root site). */
import '@ttac/shared/styles/theme.css';
import { PUBLIC_ADMIN_URL, PUBLIC_API_URL } from 'astro:env/client';
import homeButton from '@ttac/shared/styles/img/home-button.webp';
import { areaOf, currentSection, sectionsFor } from '../lib/nav';
import NavAccount from '../components/NavAccount';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const area = areaOf(Astro.url.pathname);
const current = currentSection(Astro.url.pathname);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="brand">
          <img src={homeButton.src} alt="" width="42" height="42" />
          <div>
            <span class="brand-title">Through the Ages</span>
            <span class="brand-subtitle">Competitive Community Hub</span>
          </div>
        </a>
        <button type="button" class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="main-nav">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
        <div class="nav-backdrop"></div>
        <nav id="main-nav" aria-label="Sections">
          <div class="nav-mobile-header">
            <span class="nav-mobile-title">Navigation</span>
            <button type="button" class="nav-close-btn" aria-label="Close navigation">✕</button>
          </div>
          {sectionsFor(area).map((s) => (
            <a href={s.href} class:list={{ active: current === s.href }} aria-current={current === s.href ? 'page' : undefined}>
              {s.label}
            </a>
          ))}
          <NavAccount client:only="react" apiUrl={PUBLIC_API_URL} adminUrl={PUBLIC_ADMIN_URL} current={Astro.url.pathname.startsWith('/account/')} />
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <p><strong>Through the Ages Rating Engine</strong> -- Powered by Glicko-2 and Coulom Whole-History Rating.</p>
        <p class="footer-small">
          Data from competitive online TTA tournaments<span class="run-facts"></span>. &bull;
          Designed and built by DANeo and UnstableUnicorn
        </p>
        <p class="footer-small"><a href="/privacy/">Privacy</a> &middot; <a href="mailto:support@ttacommunity.org">Contact</a></p>
      </div>
    </footer>

    <div class="site-tooltip" role="tooltip" aria-hidden="true"></div>

    <script>
      import { PUBLIC_API_URL } from 'astro:env/client';
      import { currentRun } from '@ttac/shared/ratings';
      import { runFacts } from '../lib/run-facts';
      import { placeTooltip } from '../lib/tooltip-position';

      // Without an answer the footer keeps its plain wording.
      const facts = document.querySelector('.run-facts');
      if (facts) {
        currentRun(PUBLIC_API_URL)
          .then((run) => (facts.textContent = runFacts(run)))
          .catch(() => undefined);
      }

      // The background starts below the header, whose height changes when it wraps.
      const header = document.querySelector('.site-header');
      if (header instanceof HTMLElement) {
        const setHeight = () => document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
        new ResizeObserver(setHeight).observe(header);
      }

      const nav = document.getElementById('main-nav');
      const toggle = document.querySelector('.nav-toggle');
      const backdrop = document.querySelector('.nav-backdrop');
      const setNav = (open: boolean) => {
        // A closed menu is not displayed, so it adds no width on phones; closing plays its slide first.
        if (nav && !open && nav.classList.contains('open')) {
          nav.classList.add('closing');
          if (getComputedStyle(nav).animationName === 'none') nav.classList.remove('closing');
          else nav.addEventListener('animationend', () => nav.classList.remove('closing'), { once: true });
        }
        if (open) nav?.classList.remove('closing');
        nav?.classList.toggle('open', open);
        backdrop?.classList.toggle('open', open);
        toggle?.classList.toggle('open', open);
        toggle?.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      };
      toggle?.addEventListener('click', () => setNav(!nav?.classList.contains('open')));
      document.querySelector('.nav-close-btn')?.addEventListener('click', () => setNav(false));
      backdrop?.addEventListener('click', () => setNav(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.classList.contains('open')) setNav(false);
      });

      const tooltip = document.querySelector<HTMLElement>('.site-tooltip');
      let target: HTMLElement | null = null;
      const place = () => {
        if (!tooltip || !target) return;
        const at = placeTooltip(
          target.getBoundingClientRect(),
          { width: tooltip.offsetWidth, height: tooltip.offsetHeight },
          { width: window.innerWidth, height: window.innerHeight },
          target.classList.contains('tooltip-bottom'),
        );
        tooltip.style.left = `${at.left}px`;
        tooltip.style.top = `${at.top}px`;
      };
      const show = (e: Event) => {
        const el = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-tooltip]') : null;
        const text = el?.dataset.tooltip?.trim();
        if (!tooltip || !el || !text) return;
        target = el;
        tooltip.textContent = text;
        tooltip.classList.add('visible');
        place();
      };
      const hide = (e: Event) => {
        const next = e instanceof MouseEvent || e instanceof FocusEvent ? e.relatedTarget : null;
        if (!tooltip || !target || (next instanceof Node && target.contains(next))) return;
        target = null;
        tooltip.classList.remove('visible');
      };
      document.addEventListener('mouseover', show, { passive: true });
      document.addEventListener('focusin', show);
      document.addEventListener('mouseout', hide, { passive: true });
      document.addEventListener('focusout', hide);
      window.addEventListener('scroll', place, { passive: true });
      window.addEventListener('resize', place, { passive: true });
    </script>
  </body>
</html>

<style>
  /* The header's styles are shared with admin: @ttac/shared/styles/components/site-header.css. */
  main {
    flex: 1;
    width: 100%;
    max-width: 1400px;
    margin: 2rem auto;
    padding: 0 1.5rem;
  }

  .site-footer {
    margin-top: auto;
    padding: 2rem 1.5rem;
    background: var(--surface-footer);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-stats);
    font-size: 0.85rem;
    text-align: center;
  }

  .footer-container {
    max-width: 1000px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .footer-small {
    margin-top: 0.5rem;
    color: #887864;
    font-size: 0.8rem;
  }

  .footer-small a {
    color: #887864;
    /* Underlined, as the same colour as the text would not show they are links. */
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-small a:hover {
    color: var(--accent-gold);
  }

  @media (max-width: 820px) {
    main {
      margin: 1.25rem auto;
      padding: 0 0.75rem;
    }

    .site-footer {
      padding: 1.5rem 1rem;
      padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    }
  }
</style>
