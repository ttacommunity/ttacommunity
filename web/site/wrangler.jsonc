// The public site as a Worker serving static assets: Astro's build output,
// including public/_headers. Workers Builds deploys it from main to
// ttacommunity.org, and branch dev to the Worker ttacommunity-dev (--env dev).
{
  "name": "ttacommunity",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist"
  },
  // No workers.dev hostnames, and no Previews: on the zone's apex they would claim every
  // subdomain, the API's tunnels included.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ttacommunity.org", "custom_domain": true, "previews_enabled": false }],
  "env": {
    // Branch dev, deployed as a Worker of its own at dev.ttacommunity.org, which an Access app covers.
    "dev": {
      "name": "ttacommunity-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "dev.ttacommunity.org", "custom_domain": true }]
    }
  }
}
