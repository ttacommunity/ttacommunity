// The public site as a Worker serving static assets: Astro's build output,
// including public/_headers. Cloudflare's Workers Builds deploys it from main.
{
  "name": "ttacommunity",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist"
  },
  // Only the custom domain serves the site: no workers.dev or preview hostnames.
  "workers_dev": false,
  "preview_urls": false
}
