#!/usr/bin/env bash
# Before a commit: refuse staged credentials, and staged Go that is not gofmt-clean.
# Enable with: git config core.hooksPath .githooks
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0
bash checks/secret-scan.sh --staged || fail=1
bash checks/gofmt.sh || fail=1
exit "$fail"
