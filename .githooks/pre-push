#!/usr/bin/env bash
# Before a push: refuse a push to main, and scan every file the pushed commits add or change
# for credentials, as the pushed commit holds it, including commits made with --no-verify.
# git passes one ref per stdin line.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1
zero=0000000000000000000000000000000000000000
fail=0
while read -r _ local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = refs/heads/main ]; then
    echo "REFUSED: main changes only through a pull request: push a branch and open one" >&2
    exit 1
  fi
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
    if [ -n "$base" ]; then
      mapfile -d '' files < <(git diff --name-only -z --diff-filter=ACM "$base" "$local_sha")
    else
      mapfile -d '' files < <(git ls-tree -r -z --name-only "$local_sha")
    fi
  else
    mapfile -d '' files < <(git diff --name-only -z --diff-filter=ACM "$remote_sha" "$local_sha")
  fi
  [ ${#files[@]} -eq 0 ] && continue
  bash checks/secret-scan.sh --rev "$local_sha" "${files[@]}" || fail=1
done
exit "$fail"
