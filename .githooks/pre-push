#!/usr/bin/env bash
# Before a push: scan every file the pushed commits add or change for credentials,
# including commits made with --no-verify. git passes one ref per stdin line.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1
zero=0000000000000000000000000000000000000000
changed=""
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
    if [ -n "$base" ]; then
      range=$(git diff --name-only --diff-filter=ACM "$base" "$local_sha")
    else
      range=$(git ls-tree -r --name-only "$local_sha")
    fi
  else
    range=$(git diff --name-only --diff-filter=ACM "$remote_sha" "$local_sha")
  fi
  changed="$changed$range"$'\n'
done

mapfile -t files < <(printf '%s' "$changed" | sort -u | while IFS= read -r f; do
  [ -n "$f" ] && [ -f "$f" ] && printf '%s\n' "$f"; done)
[ ${#files[@]} -eq 0 ] && exit 0
bash checks/secret-scan.sh "${files[@]}"
