// The build notifier: consumes Workers Builds events and posts finished main and dev builds to Discord.
// DISCORD_WEBHOOK_URL (main) and DISCORD_DEV_WEBHOOK_URL (dev) are secrets set in Cloudflare, never here.
{
  "name": "build-discord-notifier",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "queue": "build-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 10,
        "dead_letter_queue": "build-notifications-dlq"
      }
    ]
  }
}
