// The Email Worker that Email Routing's rules for support@, privacy@ and accounts@ send mail to, forwarding it to every
// maintainer. FORWARD_TO, their addresses, is a Worker secret, never here.
{
  "name": "ttac-mail-forward",
  "main": "worker.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false
}
